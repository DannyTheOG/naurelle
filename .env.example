# Server Configuration
PORT=4000

# Supabase Server-side (Private / Service Role)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-secret-key

# Supabase Client-side (Public / Browser Anon Key)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# Email (Resend HTTP API — Recommended for Render Free Tier)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM="Naurelle Beauty Bookings <bookings@booking.naurellebeauty.com>"
RESEND_TO=hello@naurellebeauty.com

# Email (SMTP Fallback for Local/Paid Instances)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASS=your-password
SMTP_FROM=hello@naurellebeauty.com
SMTP_TO=hello@naurellebeauty.com

